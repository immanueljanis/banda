# Server-only endpoints. Never prefix credentialed URLs with NEXT_PUBLIC_.
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_INDEXER_START_BLOCK=
# Browser wallet RPC. Use a domain/rate-limited public provider endpoint, never a private server credential.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# Reserved for the future mainnet market-data reader.
ROBINHOOD_MAINNET_RPC_URL=
# Public Privy application ID. Never put a Privy app secret in the browser.
NEXT_PUBLIC_PRIVY_APP_ID=

PRIVY_APP_SECRET=

# On-demand testnet mock quote renewal. Server-only, opt-in; no background polling.
BANDA_NAV_ON_DEMAND=false
# Acknowledge ONE signer instance, no overlapping deployments or separate worker.
BANDA_NAV_SINGLE_INSTANCE=false
# Exact browser origin of the Vercel frontend (apex redirects to www).
BANDA_APP_ORIGIN=https://www.bandafinance.xyz
# Vercel frontend: base URL of the Railway backend-only NAV service.
NEXT_PUBLIC_NAV_API_URL=
# Public ES256 verification key from Privy Dashboard > App settings.
# Accepts a PEM with literal \n separators. This is NOT the app secret.
PRIVY_VERIFICATION_KEY=
# Dedicated on-chain updater only. Never use the admin private key.
BANDA_OPERATOR_PRIVATE_KEY=
# Absolute persistent directory; mount the Railway volume here before enabling.
BANDA_NAV_STATE_DIR=/data/banda-nav
