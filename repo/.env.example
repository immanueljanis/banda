# Server-only endpoints. Never prefix credentialed URLs with NEXT_PUBLIC_.
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_INDEXER_START_BLOCK=
# Browser wallet RPC. Use a domain/rate-limited public provider endpoint, never a private server credential.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# Reserved for the future mainnet market-data reader.
ROBINHOOD_MAINNET_RPC_URL=
# Public Privy application ID. Never put a Privy app secret in the browser.
NEXT_PUBLIC_PRIVY_APP_ID=

PRIVY_APP_SECRET=
